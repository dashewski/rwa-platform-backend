# ==============================================================================
# SECRETS & SENSITIVE DATA
# ==============================================================================

# External API Keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Infrastructure Passwords
# ------------------------------------------------------------------------------
# IMPORTANT: Use 'generate-env-values.sh' to create secure strings for production
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_PASSWORD=
GRAFANA_PASSWORD=
LLDAP_ADMIN_PASSWORD=

# JWT & Authentication Secrets
# ------------------------------------------------------------------------------
# Used for signing access and refresh tokens
APP_JWT_SECRET=

# Webhooks Encryption Key
WEBHOOKS_ENCRYPTION_KEY=

# Webhook egress SSRF allowlist — DEV STAND ONLY!
# The e2e receiver (tests/webhooks.test.ts) runs on the Docker host and is
# reached as host.docker.internal. Leave empty / unset in production.
WEBHOOKS_SSRF_ALLOWED_HOSTS=

# TLS verification for outbound webhook deliveries — DEV STAND ONLY!
# The e2e receiver uses a self-signed certificate: set to 0 locally so the
# deliveries go through. Never set it on production hosts.
NODE_TLS_REJECT_UNAUTHORIZED=

# Blockchain Private Keys (KEEP THESE SECRET!)
# ------------------------------------------------------------------------------
# Development: use testnet accounts | Production: use hardware wallet/KMS if possible
BLOCKCHAIN_PROVIDER_URL=
BLOCKCHAIN_CHAIN_ID=97
TESTNET_FAUCET_WALLET_PRIVATE_KEY=
SIGNER_1_PRIVATE_KEY=
SIGNER_2_PRIVATE_KEY=
SIGNER_3_PRIVATE_KEY=

# Smart Contract Addresses (Environment Specific)
# ------------------------------------------------------------------------------
EVENT_EMITTER_ADDRESS=0x45FD7Ac4D03d12077e3fE3206A19fc6FC31032a7
HOLD_TOKEN_ADDRESS=0x1c0e214bB702572E5582085d6E25c39A2B13510d
PLATFORM_TOKEN_ADDRESS=0xb85c84e68Ed64eE497D6d8AD98811Da20a9C02ab



# ==============================================================================
# DEPLOYMENT ENVIRONMENT
# ==============================================================================

# Environment Type (development | production)
DEPLOYMENT_ENVIRONMENT=development

# Domain & Networking
# ------------------------------------------------------------------------------
# dev: rwa.local | prod: api.yourproject.com
BASE_DOMAIN=rwa.local
LLDAP_BASE_DN=dc=rwa,dc=local


# Nginx SSL Configuration
# ----------------------------------------
# Host path to your certificate files (fullchain.pem + privkey.pem): self-signed locally, Cloudflare Origin Certificate on production
NGINX_HOST_SSL_CERT_PATH=./nginx/ssl/fullchain.pem
NGINX_HOST_SSL_KEY_PATH=./nginx/ssl/privkey.pem

NGINX_SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
NGINX_SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem


# ==============================================================================
# APPLICATION CONFIGURATIONS
# ==============================================================================

# Infrastructure & Shared Services
# ------------------------------------------------------------------------------
# MongoDB
MONGODB_BASE_URI=mongodb://mongodb:27017
MONGODB_EXPORTER_PORT=9216

# RabbitMQ
RABBITMQ_BLOCKCHAIN_EVENTS_EXCHANGE=blockchain.events
RABBITMQ_CHARTS_EXCHANGE=charts.events

# Redis
REDIS_URL=redis://redis:6379

# OpenTelemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4320
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Monitoring & Logging
PROMETHEUS_RETENTION_TIME=720h
GRAFANA_ALLOW_SIGN_UP=false

# Alerting (Alertmanager -> Telegram)
# ------------------------------------------------------------------------------
# Telegram: create a bot via @BotFather (/newbot), then send the bot a message
# and read the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
# Numeric chat id (e.g. -1001234567890), without quotes.
TELEGRAM_CHAT_ID=

# Networking & Proxy
# ------------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443

# External Service Proxies
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Internal Service URLs (Docker Network)
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth:3000
RWA_SERVICE_URL=http://rwa:3000
BLOCKCHAIN_SCANNER_SERVICE_URL=http://blockchain-scanner:3000
TESTNET_FAUCET_SERVICE_URL=http://testnet-faucet:3000
ASSISTANT_SERVICE_URL=http://ai-assistant:3000
FILES_SERVICE_URL=http://files:3000
DOCUMENTS_SERVICE_URL=http://documents:3000
GALLERY_SERVICE_URL=http://gallery:3000
QUESTIONS_SERVICE_URL=http://questions:3000
PORTFOLIO_SERVICE_URL=http://portfolio:3000
BLOG_SERVICE_URL=http://blog:3000
FAQ_SERVICE_URL=http://faq:3000
COMPANY_SERVICE_URL=http://company:3000
SIGNERS_MANAGER_SERVICE_URL=http://signers-manager:3000
CHARTS_SERVICE_URL=http://charts:3000
REACTIONS_SERVICE_URL=http://reactions:3000
LOYALTY_SERVICE_URL=http://loyalty:3000
DAO_SERVICE_URL=http://dao:3000
WEBHOOKS_SERVICE_URL=http://webhooks:3000
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100

# Core Services
# ------------------------------------------------------------------------------

# Gateway Service
GATEWAY_SERVICE_NAME=gateway
GATEWAY_SERVICE_VERSION=1.0.0
GATEWAY_PORT=3000
# (URLs moved to Internal Service URLs section)

# Auth Service
AUTH_SERVICE_NAME=auth
AUTH_SERVICE_VERSION=1.0.0
AUTH_PORT=3000
AUTH_MONGODB_DBNAME=auth
AUTH_ACCESS_TOKEN_EXPIRY=15m
AUTH_REFRESH_TOKEN_EXPIRY=1d
AUTH_DOMAIN_NAME=RWA Platform
AUTH_DOMAIN_VERSION=1

# RWA Service
RWA_SERVICE_NAME=rwa
RWA_SERVICE_VERSION=1.0.0
RWA_PORT=3000
RWA_MONGODB_DBNAME=rwa
PLACEHOLDER_IMAGE_PATH=/static/placeholder.svg

# Blockchain Scanner Service
BLOCKCHAIN_SCANNER_SERVICE_NAME=blockchain-scanner
BLOCKCHAIN_SCANNER_SERVICE_VERSION=1.0.0
BLOCKCHAIN_SCANNER_PORT=3000
BLOCKCHAIN_SCANNER_MONGODB_DBNAME=blockchain-events
BLOCKCHAIN_SCANNER_BLOCK_CONFIRMATIONS=5
BLOCKCHAIN_SCANNER_SCAN_INTERVAL=5000
BLOCKCHAIN_SCANNER_BATCH_SIZE=1000
# First block scanned when no scanner state exists yet; 0 or empty = start from the emitter genesis block
BLOCKCHAIN_SCANNER_INIT_SCAN_BLOCK_NUMBER=0

# Testnet Faucet Service
TESTNET_FAUCET_SERVICE_NAME=testnet-faucet
TESTNET_FAUCET_SERVICE_VERSION=1.0.0
TESTNET_FAUCET_PORT=3000
TESTNET_FAUCET_MONGODB_DBNAME=testnet-faucet
TESTNET_FAUCET_GAS_TOKEN_AMOUNT=0.01
TESTNET_FAUCET_HOLD_TOKEN_AMOUNT=10000
TESTNET_FAUCET_PLATFORM_TOKEN_AMOUNT=10000000
TESTNET_FAUCET_REQUEST_GAS_DELAY_MS=60000
TESTNET_FAUCET_REQUEST_HOLD_DELAY_MS=60000
TESTNET_FAUCET_REQUEST_PLATFORM_DELAY_MS=60000

# Signers Infrastructure
SIGNER_1_SERVICE_NAME=signer1
SIGNER_1_SERVICE_VERSION=1.0.0
SIGNER_1_PORT=3000
SIGNER_1_MONGODB_DBNAME=signer1

SIGNER_2_SERVICE_NAME=signer2
SIGNER_2_SERVICE_VERSION=1.0.0
SIGNER_2_PORT=3000
SIGNER_2_MONGODB_DBNAME=signer2

SIGNER_3_SERVICE_NAME=signer3
SIGNER_3_SERVICE_VERSION=1.0.0
SIGNER_3_PORT=3000
SIGNER_3_MONGODB_DBNAME=signer3

SIGNERS_MANAGER_SERVICE_NAME=signers-manager
SIGNERS_MANAGER_SERVICE_VERSION=1.0.0
SIGNERS_MANAGER_PORT=3000
SIGNERS_MANAGER_MONGODB_DBNAME=signers_manager

# Content & Data Services
# ------------------------------------------------------------------------------
DOCUMENTS_SERVICE_NAME=documents
DOCUMENTS_SERVICE_VERSION=1.0.0
DOCUMENTS_PORT=3000
DOCUMENTS_MONGODB_DBNAME=documents
DOCUMENTS_ALLOWED_MIME_TYPES=application/pdf
DOCUMENTS_MAX_FILE_SIZE=26214400

GALLERY_SERVICE_NAME=gallery
GALLERY_SERVICE_VERSION=1.0.0
GALLERY_PORT=3000
GALLERY_MONGODB_DBNAME=gallery
GALLERY_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
