# Unknown hosts are dropped instead of falling through to the first server block.
server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate ${NGINX_SSL_CERT_PATH};
    ssl_certificate_key ${NGINX_SSL_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;

    return 444;
}

# Main Frontend & Gateway
server {
    listen 443 ssl;
    server_name ${BASE_DOMAIN};
    error_page 497 https://$host$request_uri;
    error_page 413 = @413_json;

    location @413_json {
        default_type application/json;
        return 413 '{"error":{"code":"VALIDATION_ERROR","message":"File size exceeds maximum allowed size"}}';
    }

    ssl_certificate ${NGINX_SSL_CERT_PATH};
    ssl_certificate_key ${NGINX_SSL_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/snippets/authelia-verify.conf;

    location / {  
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /api/graphql/stream {
        proxy_pass http://graphql_upstream/graphql/stream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ${FILES_URL_PATH}/ {
        alias /app/storage/;
        add_header X-Content-Type-Options nosniff;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /static/ {
        alias /usr/share/nginx/html/static/;
        add_header X-Content-Type-Options nosniff;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~ "^/api/rwa/metadata/0x[0-9a-fA-F]{40}/[0-9]{1,78}$" {
        include /etc/nginx/snippets/proxy-tracing.conf;
        proxy_pass http://rwa_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;

        expires 5m;
    }

    location = /api/auth/challenge {
        include /etc/nginx/snippets/proxy-tracing.conf;
        proxy_pass http://auth_upstream/challenge;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location = /api/auth/authenticate {
        include /etc/nginx/snippets/proxy-tracing.conf;
        proxy_pass http://auth_upstream/authenticate;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location = /api/auth/refresh {
        include /etc/nginx/snippets/proxy-tracing.conf;
        proxy_pass http://auth_upstream/refresh;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location = /api/auth/logout {
        include /etc/nginx/snippets/proxy-tracing.conf;
        proxy_pass http://auth_upstream/logout;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location = /api/auth/logoutAll {
        include /etc/nginx/snippets/proxy-tracing.conf;
        proxy_pass http://auth_upstream/logoutAll;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location = /api/upload/createDocument {
        include /etc/nginx/snippets/proxy-tracing.conf;
        client_max_body_size ${DOCUMENTS_MAX_FILE_SIZE};

        proxy_pass http://upload_upstream/createDocument;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location = /api/upload/createImage {
        include /etc/nginx/snippets/proxy-tracing.conf;
        client_max_body_size ${GALLERY_MAX_FILE_SIZE};

        proxy_pass http://upload_upstream/createImage;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location = /api/upload/uploadPoolImage {
        include /etc/nginx/snippets/proxy-tracing.conf;
        client_max_body_size ${TOKEN_IMAGE_MAX_FILE_SIZE};

        proxy_pass http://upload_upstream/uploadPoolImage;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location = /api/upload/uploadBusinessImage {
        include /etc/nginx/snippets/proxy-tracing.conf;
        client_max_body_size ${TOKEN_IMAGE_MAX_FILE_SIZE};

        proxy_pass http://upload_upstream/uploadBusinessImage;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location /api/graphql {
        include /etc/nginx/snippets/proxy-tracing.conf;

        proxy_pass http://graphql_upstream/graphql;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

}

# Authelia Portal
server {
    listen 443 ssl;
    server_name auth.${BASE_DOMAIN};
    ssl_certificate ${NGINX_SSL_CERT_PATH};
    ssl_certificate_key ${NGINX_SSL_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://authelia_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# LLDAP Admin UI
